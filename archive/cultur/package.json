    "@noble/hashes": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
